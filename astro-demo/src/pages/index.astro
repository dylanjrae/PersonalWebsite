---
import '../styles/global.css';

const areas = [
  ['Data infrastructure', 'Backend systems, high-volume data flows, APIs, and the practical plumbing behind useful products.'],
  ['Crypto / Web3 data', 'Experience around blockchain datasets, developer-facing infrastructure, and the messy edges of decentralized systems.'],
  ['Tools & automation', 'Scripts, workflows, internal tools, and small products that remove repetition or make decisions easier.'],
  ['Engineering roots', 'Electrical engineering background with hands-on projects across embedded systems, CAD, hardware, and field work.'],
];

const timeline = [
  ['Current', 'Software Engineer, Coinbase', 'Building software for financial infrastructure.'],
  ['Before', 'Software Engineer, Covalent', 'Worked on data infrastructure for decentralized technologies.'],
  ['Earlier', 'Hardware, finance, energy', 'Electrical engineering, finance, field work, and hardware projects across early-stage and industrial contexts.'],
];

const tags = ['Python', 'Go', 'TypeScript', 'Java', 'SQL', 'Postgres', 'ClickHouse', 'APIs', 'Automation', 'Data systems', 'Web3', 'Finance'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dylan Rae</title>
    <meta name="description" content="Dylan Rae — software engineer, builder, and systems thinker." />
  </head>
  <body>
    <header class="topbar">
      <nav class="shell nav" aria-label="Primary navigation">
        <a class="brand" href="/demo/">Dylan Rae <span>/ personal index</span></a>
        <div class="nav-links">
          <a href="#areas">Areas</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main class="shell">
      <section class="hero">
        <div>
          <p class="kicker">software · systems · useful tools</p>
          <p class="lede">
            I work on practical systems: software, automation, crypto data, hardware-adjacent projects, and the business context around them.
          </p>
        </div>
        <aside class="hero-card" aria-label="Quick facts">
          <div class="status-row"><span>base</span><strong>Vancouver</strong></div>
          <div class="status-row"><span>current</span><strong>Coinbase</strong></div>
          <div class="status-row"><span>background</span><strong>software</strong></div>
          <div class="status-row"><span>mode</span><strong>accelerating</strong></div>
        </aside>
      </section>

      <section id="areas" class="section">
        <div class="section-label">Areas</div>
        <div>
          <div class="grid">
            {areas.map(([title, description]) => (
              <article class="card">
                <h3>{title}</h3>
                <p>{description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="experience" class="section">
        <div class="section-label">Experience</div>
        <div class="timeline">
          {timeline.map(([period, title, description]) => (
            <article class="role">
              <time>{period}</time>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-label">Toolkit</div>
        <div>
          <h2>Comfortable across backend systems, data, automation, and technical/product tradeoffs.</h2>
          <div class="tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </section>

      <section id="contact" class="section">
        <div class="section-label">Contact</div>
        <div class="panel">
          <h2>Want to work together or build something together?</h2>
          <p class="lede">If there’s something worth comparing notes on, these are the best places to reach me.</p>
          <div class="links">
            <a class="button primary" href="https://www.linkedin.com/in/dylan-rae/">linkedin</a>
            <a class="button" href="mailto:dylan@dylanrae.ca">email</a>
            <a class="button" href="https://github.com/dylanjrae">github</a>
          </div>
        </div>
      </section>

      <footer class="footer">
        <span>© {new Date().getFullYear()} Dylan Rae</span>
        <span>demo prototype · not final</span>
      </footer>
    </main>
  </body>
</html>
